#!/usr/bin/env bash
# Blocks any commit that would put company data on GitHub (this repo is public).
# Blocked: files under companies/, src/companies/ (except _example.ts), out/, review/, and any added line that
# contains a company name or slug this machine knows about (STYLE-REGISTRY.md rows + companies/<slug> folders).
KIT="$(git rev-parse --show-toplevel)"
fail=0
bad_paths="$(git diff --cached --name-only --diff-filter=AM | /usr/bin/grep -E '^(companies/|out/|review/|STYLE-REGISTRY\.md$)' | /usr/bin/grep -v '^companies/\.gitkeep$')"
bad_paths="$bad_paths$(git diff --cached --name-only --diff-filter=AM | /usr/bin/grep -E '^src/companies/' | /usr/bin/grep -v '^src/companies/_example\.ts$')"
if [ -n "$bad_paths" ]; then echo "⛔ Company files staged (they must stay local):"; echo "$bad_paths"; fail=1; fi

words="$( (ls -1 "$KIT/companies" 2>/dev/null; awk -F'|' 'NR>2 && $2 !~ /Starter kit|Company|---/ {gsub(/^ +| +$/, "", $2); print $2}' "$KIT/STYLE-REGISTRY.md" 2>/dev/null) | /usr/bin/grep -vE '^[[:space:]]*$|^\.gitkeep$' | sort -u)"
if [ -n "$words" ]; then
  added="$(git diff --cached -U0 --diff-filter=AM | /usr/bin/grep -E '^\+[^+]')"
  while IFS= read -r w; do
    for t in "$w" $w; do  # the full name, then each word of it (4+ letters)
      [ ${#t} -ge 4 ] || continue
      hit="$(printf '%s\n' "$added" | /usr/bin/grep -iwF -- "$t" | head -3)"
      if [ -n "$hit" ]; then echo "⛔ \"$t\" (a company on this machine) appears in staged changes:"; echo "$hit"; fail=1; fi
    done
  done <<< "$words"
fi
if [ "$fail" = 1 ]; then echo "Commit blocked: remove company data from shared files, then commit again."; exit 1; fi
